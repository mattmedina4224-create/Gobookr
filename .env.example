# GoBookr environment configuration
# Copy these names into your hosting provider's environment settings.
# Never commit real secret values.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase Postgres. Use the server-side connection string from Supabase Connect.
DATABASE_URL=
DB_QUERY_TIMEOUT_MS=30000

# Supabase Storage (server only — never expose the service-role key to browsers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Google Identity Services
GOOGLE_CLIENT_ID=

# Admin access is provisioned by user ID; see docs/admin-access.md.

# Only enable this when deployed behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
